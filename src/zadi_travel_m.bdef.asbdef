managed implementation in class zcl_bp_save unique;
strict ( 2 );

define behavior for zadi_travel_m //alias Travel
implementation in class zcl_bp_adi_travel_m unique
persistent table zad_travel_m
with additional save
lock master
authorization master ( instance )
etag master LastChangedAt
early numbering
{
  //static field control
  field ( readonly ) TravelId, LastChangedBy, LastChangedAt, CreatedBy, CreatedAt; //sets fields as read only
  field ( mandatory ) AgencyId, CustomerId, BeginDate, EndDate, OverallStatus, BookingFee, CurrencyCode; //sets fields as mandator
  //dynamic field control
  action ( features : instance ) acceptTravel result [1] $self;
  action ( features : instance ) rejectTravel result [1] $self;

  factory action copyTravel [1];

  internal action recalcTotPrice;

  //Validations
  validation validateCustomer on save { create; field CustomerId; }
  validation validateDates on save { create; field BeginDate, EndDate; }
  validation validateStatus on save { create; field OverallStatus; }
  validation validateCurrencyCode on save { create; field CurrencyCode; }
  validation validateBookingFee on save { create; field BookingFee; }

  //Determination
  determination calculateTotalPrice on modify { create; field BookingFee,CurrencyCode; }

  create;
  update;
  delete;
  association _Booking { create ( features : instance ); } //prevents booking creation when travel is rejected
  mapping for zad_travel_m
    {
      TravelId      = travel_id;
      AgencyId      = agency_id;
      CustomerId    = customer_id;
      BeginDate     = begin_date;
      EndDate       = end_date;
      BookingFee    = booking_fee;
      TotalPrice    = total_price;
      CurrencyCode  = currency_code;
      Description   = description;
      OverallStatus = overall_status;
      CreatedBy     = created_by;
      CreatedAt     = created_at;
      LastChangedBy = last_changed_by;
      LastChangedAt = last_changed_at;
    }
}

define behavior for ZADI_BOOKING_M //alias <alias_name>
implementation in class zcl_bp_adi_booking_m unique
persistent table zad_booking_m
lock dependent by _Travel
authorization dependent by _Travel
etag master LastChangedAt
early numbering
{
  update;
  delete;
  field ( readonly ) TravelId, BookingId;
  field ( mandatory ) CarrierId, ConnectionId, FlightDate, BookingStatus, LastChangedAt;
  field ( mandatory : create, readonly : update ) BookingDate, CustomerId; //make this fields mandatory on create, but readonly on update

  //Validation
  validation validateStatus on save { create; field BookingStatus; }
  validation validateCustomer on save { create; field CustomerId; }
  validation validateCurrencyCode on save { create; field CurrencyCode; }
  validation validateConnection on save { create; field CarrierId, ConnectionId, FlightDate; }
  validation validateFlightPrice on save { create; field FlightPrice; }

  //determinations
  determination calculateTotalPrice on modify { create; field FlightPrice,CurrencyCode; }

  association _Travel;
  association _BookingSuppl { create ( features : instance ); }
  mapping for zad_booking_m
    {
      TravelId      = travel_id;
      BookingId     = booking_id;
      BookingDate   = booking_date;
      CustomerId    = customer_id;
      CarrierId     = carrier_id;
      ConnectionId  = connection_id;
      FlightDate    = flight_date;
      FlightPrice   = flight_price;
      CurrencyCode  = currency_code;
      BookingStatus = booking_status;
      LastChangedAt = last_changed_at;
    }
}

define behavior for ZADI_BOOKSUPPL_M //alias <alias_name>
implementation in class zcl_bp_adi_booksuppl_m unique
persistent table zad_booksuppl_m
lock dependent by _Travel
authorization dependent by _Travel
etag master LastChangedAt
early numbering
{
  update;
  delete;
  field ( readonly ) TravelId, BookingId, BookingSupplementId, LastChangedAt;
  field ( mandatory ) Price, SupplementId;

  //Validate
  validation validateCurrencyCode on save { create; field CurrencyCode; }
  validation validateSupplement on save { create; field SupplementId; }
  validation validatePrice on save { create; field price; }

  //determinations
  determination calculateTotalPrice on modify { create; field Price,CurrencyCode; }

  association _Travel;
  association _Booking;
  mapping for zad_booksuppl_m
    {
      TravelId            = travel_id;
      BookingId           = booking_id;
      BookingSupplementId = booking_supplement_id;
      SupplementId        = supplement_id;
      Price               = price;
      CurrencyCode        = currency_code;
      LastChangedAt       = last_changed_at;
    }
}